{
  "name": "imgz.pw",
  "domains": [
    "imgz.pw"
  ],
  "note": "2018",
  "referer": "https://imgz.pw/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' code_image ')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' code_image ')]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
