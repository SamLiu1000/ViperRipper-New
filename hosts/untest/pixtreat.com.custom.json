{
  "name": "pixtreat.com",
  "domains": [
    "pixtreat.com"
  ],
  "note": "2018",
  "referer": "https://pixtreat.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='img_obj']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='img_obj']",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
