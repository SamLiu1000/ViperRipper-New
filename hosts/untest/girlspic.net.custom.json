{
  "name": "girlspic.net",
  "domains": [
    "girlspic.net"
  ],
  "note": "2018",
  "referer": "https://girlspic.net/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@data-load='full']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@data-load='full']",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
