{
  "name": "image18.org",
  "domains": [
    "image18.org"
  ],
  "note": "2018",
  "referer": "https://image18.org/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='picture']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='picture']",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
