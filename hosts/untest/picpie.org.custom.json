{
  "name": "picpie.org",
  "domains": [
    "picpie.org"
  ],
  "note": "2018",
  "referer": "https://picpie.org/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//a[@download]",
      "attr": "href"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//a[@download]",
      "attr": "download",
      "default": "{url_name}"
    }
  ]
}
