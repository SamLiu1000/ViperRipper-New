{
  "name": "picshare.ru",
  "domains": [
    "picshare.ru"
  ],
  "note": "2018",
  "referer": "https://picshare.ru/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='image']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='image']",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
