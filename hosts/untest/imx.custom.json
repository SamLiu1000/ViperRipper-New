{
  "name": "imx",
  "domains": [
    "imx.to"
  ],
  "note": "recorded 2026-10-18 (extension v3)",
  "referer": "https://imx.to/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "post",
      "url": "https://imx.to/i/55jrdt",
      "grab_form": true
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(@class, 'centred')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(@class, 'centred')]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
