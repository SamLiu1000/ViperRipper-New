{
  "name": "gallerysense.se",
  "domains": [
    "gallerysense.se"
  ],
  "note": "2018",
  "referer": "https://gallerysense.se/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//a[@target='_blank']",
      "attr": "href"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//a[@target='_blank']",
      "attr": "href",
      "default": "{url_name}"
    }
  ]
}
