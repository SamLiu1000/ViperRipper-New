{
  "name": "imgflip.com",
  "domains": [
    "imgflip.com"
  ],
  "note": "2018",
  "referer": "https://imgflip.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='im']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='im']",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
