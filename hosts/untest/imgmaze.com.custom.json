{
  "name": "imgmaze.com",
  "domains": [
    "imgmaze.com"
  ],
  "note": "2018",
  "referer": "https://imgmaze.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "search",
      "url": "{body}",
      "field": "pp_next",
      "selector": "name=\"next\" value=\"(.*?)\""
    },
    {
      "action": "search",
      "url": "{body}",
      "field": "pp_op",
      "selector": "name=\"op\" value=\"(.*?)\""
    },
    {
      "action": "search",
      "url": "{body}",
      "field": "pp_pre",
      "selector": "name=\"pre\" value=\"(.*?)\""
    },
    {
      "action": "search",
      "url": "{body}",
      "field": "pp_id",
      "selector": "name=\"id\" value=\"(.*?)\""
    },
    {
      "action": "search",
      "url": "{body}",
      "field": "pp_regexvalue1inputtypehiddennamevalue1inputtypesubmit",
      "selector": "value=\"(.+?)\"\u003e\u003cinput type=\"submit\" name=\"next\""
    },
    {
      "action": "post",
      "url": "{page_url}",
      "data": {
        "id": "{pp_id}",
        "next": "{pp_next}",
        "op": "{pp_op}",
        "pre": "{pp_pre}",
        "regex:value=\"1\"\u003e\u003cinput type=\"hidden\" name=\"(.+?)\" value=\"1\"\u003e\u003cinput type=\"submit\"": "{pp_regexvalue1inputtypehiddennamevalue1inputtypesubmit}"
      }
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' pic ')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' pic ')]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
