{
  "name": "image-bugs.com",
  "domains": [
    "image-bugs.com"
  ],
  "note": "2018",
  "referer": "https://image-bugs.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//link[@rel='image_src']",
      "attr": "href"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//meta[@property='og:title']",
      "attr": "content",
      "default": "{url_name}"
    }
  ]
}
