{
  "name": "gallerynova.se",
  "domains": [
    "gallerynova.se"
  ],
  "note": "由原版 ViperRipper (2018) hosts.xml 转换；imageAction=NEED_NOTHING；未经实机验证，下载异常时在规则列表里关掉即可",
  "referer": "https://gallerynova.se/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//a[@target='_blank']",
      "attr": "href"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//a[@target='_blank']",
      "attr": "href",
      "default": "{url_name}"
    }
  ]
}
