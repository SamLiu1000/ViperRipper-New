{
  "name": "pixhost",
  "domains": [
    "pixhost.cc"
  ],
  "note": "recorded 2026-10-17 (extension v2)",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='image']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='image']",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
