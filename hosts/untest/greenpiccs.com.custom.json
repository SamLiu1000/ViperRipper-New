{
  "name": "greenpiccs.com",
  "domains": [
    "greenpiccs.com"
  ],
  "note": "2018",
  "referer": "https://greenpiccs.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//a[contains(@href,'/images/')]",
      "attr": "href"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//a[contains(@href,'/images/')]",
      "attr": "title",
      "default": "{url_name}"
    }
  ]
}
