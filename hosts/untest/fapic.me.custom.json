{
  "name": "fapic.me",
  "domains": [
    "fapic.me"
  ],
  "note": "2018",
  "referer": "https://fapic.me/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
