{
  "name": "imgcoin.net",
  "domains": [
    "imgcoin.net"
  ],
  "note": "2018",
  "referer": "https://imgcoin.net/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "pp_next",
      "selector": "//input[@name='next']",
      "attr": "value"
    },
    {
      "action": "extract",
      "field": "pp_op",
      "selector": "//input[@name='op']",
      "attr": "value"
    },
    {
      "action": "extract",
      "field": "pp_pre",
      "selector": "//input[@name='pre']",
      "attr": "value"
    },
    {
      "action": "extract",
      "field": "pp_id",
      "selector": "//input[@name='id']",
      "attr": "value"
    },
    {
      "action": "post",
      "url": "{page_url}",
      "data": {
        "id": "{pp_id}",
        "next": "{pp_next}",
        "op": "{pp_op}",
        "pre": "{pp_pre}"
      }
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
