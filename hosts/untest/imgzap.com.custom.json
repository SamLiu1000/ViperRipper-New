{
  "name": "imgzap.com",
  "domains": [
    "imgzap.com"
  ],
  "note": "2018",
  "referer": "https://imgzap.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@onclick='scale(this);']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@onclick='scale(this);']",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
