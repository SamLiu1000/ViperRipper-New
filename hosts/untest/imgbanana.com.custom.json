{
  "name": "imgbanana.com",
  "domains": [
    "imgbanana.com"
  ],
  "note": "由原版 ViperRipper (2018) hosts.xml 转换；imageAction=NEED_POST；未经实机验证，下载异常时在规则列表里关掉即可",
  "referer": "https://imgbanana.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "pp_clic",
      "selector": "//input[@name='clic']",
      "attr": "value"
    },
    {
      "action": "post",
      "url": "{page_url}",
      "data": {
        "clic": "{pp_clic}"
      }
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='cursor_lupa']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='cursor_lupa']",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
