{
  "name": "pic-upload.de",
  "domains": [
    "pic-upload.de"
  ],
  "note": "2018",
  "referer": "https://pic-upload.de/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[starts-with(@class,'preview_picture')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[starts-with(@class,'preview_picture')]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
