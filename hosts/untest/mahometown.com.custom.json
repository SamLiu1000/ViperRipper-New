{
  "name": "mahometown.com",
  "domains": [
    "mahometown.com"
  ],
  "note": "2018",
  "referer": "https://mahometown.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' gallery-full-pic ')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' gallery-full-pic ')]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
