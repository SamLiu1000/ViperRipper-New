{
  "name": "pixhub.eu",
  "domains": [
    "pixhub.eu"
  ],
  "note": "2018",
  "referer": "https://pixhub.eu/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@onload='ustaw(100000);']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@onload='ustaw(100000);']",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
