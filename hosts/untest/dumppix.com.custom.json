{
  "name": "dumppix.com",
  "domains": [
    "dumppix.com"
  ],
  "note": "2018",
  "referer": "https://dumppix.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "page_url",
      "selector": "//a[contains(@href,'viewer')]",
      "attr": "href"
    },
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' selected ')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//a[contains(@href,'viewer')]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
