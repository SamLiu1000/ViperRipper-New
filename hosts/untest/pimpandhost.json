{
  "name": "pimpandhost",
  "domains": [
    "pimpandhost.com"
  ],
  "enabled": true,
  "steps": [
    {
      "action": "regex",
      "url": "{page_url}",
      "field": "page_url",
      "selector": "-medium(\\.html)?"
    },
    {
      "action": "regex",
      "field": "page_url",
      "selector": "^([^?]*)$",
      "replace": "${1}?size=original"
    },
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(@class, 'original')]",
      "attr": "src",
      "prefix": "https:"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(@class, 'original')]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
