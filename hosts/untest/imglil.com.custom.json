{
  "name": "imglil.com",
  "domains": [
    "imglil.com"
  ],
  "note": "2018",
  "referer": "https://imglil.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "pp_next",
      "selector": "//input[@name='next']",
      "attr": "value"
    },
    {
      "action": "extract",
      "field": "pp_1",
      "selector": "//input[@name='1']",
      "attr": "value"
    },
    {
      "action": "extract",
      "field": "pp_2",
      "selector": "//input[@name='2']",
      "attr": "value"
    },
    {
      "action": "extract",
      "field": "pp_3",
      "selector": "//input[@name='3']",
      "attr": "value"
    },
    {
      "action": "post",
      "url": "{page_url}",
      "data": {
        "1": "{pp_1}",
        "2": "{pp_2}",
        "3": "{pp_3}",
        "next": "{pp_next}"
      }
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(@src,'imglil')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(@src,'imglil')]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
