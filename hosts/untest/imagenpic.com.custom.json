{
  "name": "imagenpic.com",
  "domains": [
    "imagenpic.com"
  ],
  "note": "2018",
  "referer": "https://imagenpic.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' pic ')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' pic ')]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
