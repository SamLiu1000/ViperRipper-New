{
  "name": "imagegaga.net",
  "domains": [
    "imagegaga.net"
  ],
  "note": "2018",
  "referer": "https://imagegaga.net/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='full_image']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='full_image']",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
