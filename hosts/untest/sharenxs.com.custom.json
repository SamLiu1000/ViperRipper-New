{
  "name": "sharenxs.com",
  "domains": [
    "sharenxs.com"
  ],
  "note": "由原版 ViperRipper (2018) hosts.xml 转换；imageAction=NEED_NOTHING；未经实机验证，下载异常时在规则列表里关掉即可",
  "referer": "https://sharenxs.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' view_photo ')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(concat(' ',normalize-space(@class),' '),' view_photo ')]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
