{
  "name": "postimg.org",
  "domains": [
    "postimg.org"
  ],
  "note": "2018",
  "referer": "https://postimg.org/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[@id='main-image']",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[@id='main-image']",
      "attr": "img[src*=postimg]",
      "default": "{url_name}"
    }
  ]
}
