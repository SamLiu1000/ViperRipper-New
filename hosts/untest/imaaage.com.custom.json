{
  "name": "imaaage.com",
  "domains": [
    "imaaage.com"
  ],
  "note": "2018",
  "referer": "https://imaaage.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(@src,'imaaage')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(@src,'imaaage')]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
