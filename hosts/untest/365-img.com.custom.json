{
  "name": "365-img.com",
  "domains": [
    "365-img.com"
  ],
  "note": "由原版 ViperRipper (2018) hosts.xml 转换；imageAction=NEED_NOTHING；未经实机验证，下载异常时在规则列表里关掉即可",
  "referer": "https://365-img.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//link[@rel='image_src']",
      "attr": "href"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//link[@rel='image_src']",
      "attr": "href",
      "default": "{url_name}"
    }
  ]
}
