{
  "name": "imgadult.com",
  "domains": [
    "imgadult.com"
  ],
  "note": "2018",
  "referer": "https://imgadult.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
