{
  "name": "imgtrial.com",
  "domains": [
    "imgtrial.com"
  ],
  "note": "2018",
  "referer": "https://imgtrial.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "pp_imgcontinue",
      "selector": "//input[@name='imgContinue']",
      "attr": "value"
    },
    {
      "action": "post",
      "url": "{page_url}",
      "data": {
        "imgContinue": "{pp_imgcontinue}"
      }
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[(contains(@class,'centred') or contains(@class,'centred_resized'))]",
      "attr": "src",
      "default": "{url_name}"
    }
  ]
}
