{
  "name": "idolwall.com",
  "domains": [
    "idolwall.com"
  ],
  "note": "2018",
  "referer": "https://idolwall.com/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(@class,'mainImage img-thumbnail')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(@class,'mainImage img-thumbnail')]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
