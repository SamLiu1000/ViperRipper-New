{
  "name": "imagebam",
  "domains": [
    "imagebam.com"
  ],
  "enabled": true,
  "steps": [
    {
      "action": "set-cookie",
      "name": "nsfw_inter",
      "value": "1"
    },
    {
      "action": "set-cookie",
      "name": "sfw_inter",
      "value": "1"
    },
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "extract",
      "field": "image_url",
      "selector": "//img[contains(@class,'main-image')]",
      "attr": "src"
    },
    {
      "action": "extract",
      "field": "filename",
      "selector": "//img[contains(@class,'main-image')]",
      "attr": "alt",
      "default": "{url_name}"
    }
  ]
}
