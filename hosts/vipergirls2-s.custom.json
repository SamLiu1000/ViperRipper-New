{
  "name": "vipergirls2-s",
  "domains": [
    "vipergirls.to"
  ],
  "note": "recorded 2026-10-18 (extension v3), source search fallback",
  "referer": "https://vipergirls.to/",
  "enabled": true,
  "steps": [
    {
      "action": "get",
      "url": "{page_url}"
    },
    {
      "action": "search",
      "url": "{body}",
      "field": "image_url",
      "selector": "https?://[^\"'\\s\u003c\u003e]+image[^\"'\\s\u003c\u003e]*"
    },
    {
      "action": "set",
      "field": "filename",
      "value": "{url_name}"
    }
  ]
}
